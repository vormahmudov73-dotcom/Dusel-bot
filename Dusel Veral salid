# UPDATE PROCESSOR
# ============================================================

def process_update(update):
    if "callback_query" in update:
        handle_callback(update)
        return

    if "message" in update:
        handle_message(update)


# ============================================================
# 24/7 LONG POLLING LOOP
# ============================================================

def run_bot():
    offset = 0

    # Eski webhook bo'lsa, long polling ishlamasligi mumkin.
    try:
        api("deleteWebhook", {"drop_pending_updates": "false"})
        logging.info("Webhook o'chirildi. Long polling ishga tushadi.")
    except Exception as e:
        logging.warning("Webhookni o'chirishda ogohlantirish: %s", e)

    # Token tekshirish
    me = api("getMe")
    bot_username = me["result"].get("username", "unknown")
    logging.info("Bot ishga tushdi: @%s", bot_username)
    logging.info("Admin ID: %s", ADMIN_ID)
    logging.info("Database: %s", DB_FILE)

    retry_delay = 3

    while running:
        try:
            result = api(
                "getUpdates",
                {
                    "offset": offset,
                    "timeout": 50,
                    "allowed_updates": json.dumps(
                        ["message", "callback_query"]
                    )
                }
            )

            retry_delay = 3

            for update in result.get("result", []):
                offset = update["update_id"] + 1

                try:
                    process_update(update)
                except Exception:
                    logging.exception(
                        "Update qayta ishlashda xato"
                    )

        except urllib.error.HTTPError as e:
            logging.error(
                "HTTP xato: %s. %s soniyadan keyin qayta urinadi.",
                e.code,
                retry_delay
            )
            time.sleep(retry_delay)
            retry_delay = min(retry_delay * 2, 60)

        except (
            urllib.error.URLError,
            TimeoutError,
            ConnectionError,
            OSError
        ) as e:
            logging.error(
                "Internet/ulanish xatosi: %s. "
                "%s soniyadan keyin qayta urinadi.",
                e,
                retry_delay
            )
            time.sleep(retry_delay)
            retry_delay = min(retry_delay * 2, 60)

        except Exception:
            logging.exception(
                "Asosiy loopda kutilmagan xato. "
                "%s soniyadan keyin qayta urinadi.",
                retry_delay
            )
            time.sleep(retry_delay)
            retry_delay = min(retry_delay * 2, 60)

    logging.info("Bot to'xtadi.")


if __name__ == "__main__":
    try:
        run_bot()
    finally:
        db.close()
