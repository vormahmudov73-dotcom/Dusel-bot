def get_client(chat_id):
    return db.execute(
        "SELECT chat_id, name, phone FROM clients WHERE chat_id = ?",
        (chat_id,)
    ).fetchone()


def save_client(chat_id, name, phone):
    db.execute(
        "INSERT OR REPLACE INTO clients (chat_id, name, phone) VALUES (?, ?, ?)",
        (chat_id, name, phone)
    )
    db.commit()


def save_order_history(chat_id, items):
    for item in items:
        total = item["price"] * item["qty"]
        db.execute(
            "INSERT INTO order_history (chat_id, name, price, qty, total) VALUES (?, ?, ?, ?, ?)",
            (chat_id, item["name"], item["price"], item["qty"], total)
        )
    db.commit()


