def handle_callback(update):
    callback = update["callback_query"]

    callback_id = callback["id"]
    message = callback.get("message")

    if not message:
        api(
            "answerCallbackQuery",
            {"callback_query_id": callback_id}
        )
        return

    chat_id = message["chat"]["id"]
    message_id = message["message_id"]
    data = callback.get("data", "")

    api(
        "answerCallbackQuery",
        {
            "callback_query_id": callback_id
        }
    )

    if data == "admin_clients":
        if chat_id != ADMIN_ID:
            return
        edit(chat_id, message_id, "MIJOZLAR\n\nMijozni tanlang:", admin_client_list())

    elif data.startswith("admin_client_"):
        if chat_id != ADMIN_ID:
            return
        try:
            client_id = int(data[len("admin_client_"):])
        except ValueError:
            return
        text, keyboard = admin_client_detail(client_id)
        edit(chat_id, message_id, text, keyboard)

    elif data == "my_list":
        send(chat_id, my_list(chat_id), my_list_keyboard())

    elif data == "home":
        edit(
            chat_id,
            message_id,
            " DUSEL 12-DOKON\n\n"
            "Kerakli bo‘limni tanlang:",
            main_menu(chat_id)
        )

    elif data == "categories":
        edit(
            chat_id,
            message_id,
            " MAHSULOTLAR\n\n"
            " Kategoriyani tanlang:",
            categories(chat_id)
        )

    elif data == "brand_dusel":
        edit(
            chat_id,
            message_id,
            " DUSEL\n\n Bo‘limni tanlang:",
            dusel_categories()
        )

    elif data == "brand_veral":
        edit(chat_id,message_id,"VERAL\n\nBo‘limni tanlang:",veral_categories())

    elif data == "brand_salid":
        edit(
            chat_id,
            message_id,
            " SALID\n\nHozircha mahsulotlar qo‘shilmagan.",
            {"inline_keyboard": [[{"text": "⬅ BRENDLAR", "callback_data": "categories"}]]}
        )

    elif data == "cat_led":
        edit(
            chat_id,
            message_id,
            " LED LAMPALAR\n\n"
            "Mahsulotni tanlang:",
            product_keyboard("dusel_led")
        )

    elif data == "cat_patron":
        edit(
            chat_id,
            message_id,
            " PATRONLI LAMPALAR\n\n"
            "Mahsulotni tanlang:",
            product_keyboard("dusel_patron")
        )

    elif data.startswith("product_"):
        parts = data.rsplit("_", 1)

        if len(parts) != 2 or not parts[0].startswith("product_"):
            return

        category = parts[0][len("product_"):]

        try:
            index = int(parts[1])
        except ValueError:
            return

        if category not in PRODUCTS:
            return

        if index < 0 or index >= len(PRODUCTS[category]):
            return

        name = PRODUCTS[category][index][0]
        price = PRODUCTS[category][index][1]

        selected[chat_id] = {
            "name": name,
            "price": price
        }

        send(
            chat_id,
            " " + name +
            "\n\n Narxi: $" +
            format(price, ".2f") +
            "\n\n Nechta kerak?\n"
            "Masalan: 5\n\n"
            " Faqat sonini yozing."
        )

    elif data in {"veral_led","veral_lyustra","veral_square_inside","veral_round_inside","veral_square_outside","veral_round_outside"}:
        titles={"veral_led":"VERAL LED LAMPALAR","veral_lyustra":"VERAL LYUSTRA LAMPALAR","veral_square_inside":"TO‘RT BURCHAK ICHKI AKRIL","veral_round_inside":"DUMALOQ ICHKI AKRIL","veral_square_outside":"TO‘RT BURCHAK TASHQI AKRIL","veral_round_outside":"DUMALOQ TASHQI AKRIL"}
        edit(chat_id,message_id,titles[data]+"\n\nMahsulotni tanlang:",product_keyboard(data,"brand_veral","VERAL BO‘LIMLARI"))

    elif data == "cart":
        items = cart_items(chat_id)

        if not items:
            send(
                chat_id,
                " SAVATCHA\n\n"
                "Savatcha hozircha bo‘sh.",
                main_menu(chat_id)
            )
            return

        text = " SIZNING SAVATCHANGIZ\n\n"
        total = 0

        for item in items:
            subtotal = item["price"] * item["qty"]
            total += subtotal

            text += (
                " " + item["name"] + "\n"
                " " + str(item["qty"]) + " dona\n"
                " $" + format(subtotal, ".2f") + "\n\n"
            )

        text += (
            "━━━━━━━━━━━━\n"
            " JAMI: $" + format(total, ".2f")
        )

        send(
            chat_id,
            text,
            cart_keyboard()
        )

    elif data == "clear":
        clear_cart(chat_id)

        selected.pop(chat_id, None)
        orders.pop(chat_id, None)

        send(
            chat_id,
            " Savatcha tozalandi.",
            main_menu(chat_id)
        )

    elif data == "cancel_order":
        orders.pop(chat_id, None)
        send(chat_id, "Zakaz bekor qilindi.", main_menu())

    elif data == "confirm_order":
        if chat_id not in orders:
            return
        client = get_client(chat_id)
        items = cart_items(chat_id)
        if not client or not items:
            orders.pop(chat_id, None)
            send(chat_id, "Zakaz uchun ma’lumot yoki savatcha yetarli emas.", main_menu())
            return

        total = 0
        admin_text = (
            "YANGI ZAKAZ!\n\n"
            "KLIENT: " + client[1] + "\n"
            "TELEFON: " + client[2] + "\n\n"
            "MAHSULOTLAR:\n\n"
        )
