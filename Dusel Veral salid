            total += summa
            admin_text += item["name"] + "\n" + str(item["qty"]) + " dona\n$" + format(summa, ".2f") + "\n\n"
        admin_text += "━━━━━━━━━━━━\nJAMI: $" + format(total, ".2f") + "\n\nTelegram ID: " + str(chat_id)

        save_order_history(chat_id, items)
        send(ADMIN_ID, admin_text)
        send(
            chat_id,
            "ZAKAZ QABUL QILINDI!\n\n"
            "Klient: " + client[1] + "\n"
            "Telefon: " + client[2] + "\n\n"
            "JAMI: $" + format(total, ".2f") + "\n\n"
            "Zakazingiz spiskangizga saqlandi.",
            main_menu(chat_id)
        )
        clear_cart(chat_id)
        orders.pop(chat_id, None)

    elif data == "save_to_list":
        items = cart_items(chat_id)
        if not items:
            send(chat_id, "🛒 Savatcha bo‘sh.", main_menu())
            return
        save_to_list(chat_id, items)
        send(
            chat_id,
            "📝 Spiskaga qo‘shildi.\n\nMening spiskam bo‘limidan ko‘rishingiz mumkin.",
            my_list_keyboard()
        )

    elif data == "checkout":
        if not cart_items(chat_id):
            send(
                chat_id,
                " Savatcha bo‘sh."
            )
            return

        client = get_client(chat_id)
        if not client:
            registration[chat_id] = {"step": "name"}
            send(chat_id, "Avval registratsiyadan o‘ting.\n\nIsm va familiyangizni yozing:")
