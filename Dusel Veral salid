            send(
                chat_id,
                "Assalomu alaykum, " + client[1] + "!\n\n"
                "Siz registratsiyadan o‘tgansiz. Kerakli bo‘limni tanlang.",
                main_menu(chat_id)
            )
        return

    # ========================================================
    # REGISTRATSIYA
    # ========================================================
    if chat_id in registration:
        step = registration[chat_id]["step"]

        if step == "name":
            if not text:
                send(chat_id, "Ism va familiyangizni yozing.")
                return
            registration[chat_id]["name"] = text
            registration[chat_id]["step"] = "phone"
            send(chat_id, "Telefon raqamingizni yozing:\n\nMasalan: +998901234567")
            return

        if step == "phone":
            if not text:
                send(chat_id, "Telefon raqamingizni yozing.")
                return
            name = registration[chat_id]["name"]
            save_client(chat_id, name, text)
            registration.pop(chat_id, None)
            send(
                chat_id,
                "Registratsiya muvaffaqiyatli yakunlandi.\n\n"
                "Ism: " + name + "\n"
                "Telefon: " + text + "\n\n"
                "Endi mahsulot tanlashingiz mumkin.",
                main_menu(chat_id)
            )
            return

    # ========================================================
    # MAHSULOT SONI
    # ========================================================

    if chat_id in selected:
        try:
            qty = int(text)

            if qty <= 0:
                raise ValueError

        except (ValueError, TypeError):
            send(
                chat_id,
                " Faqat son yozing.\n\n"
                "Masalan: 5"
            )
            return

        product = selected[chat_id]

        add_cart_item(
            chat_id,
            product["name"],
            product["price"],
            qty
        )

        selected.pop(chat_id, None)

        summa = product["price"] * qty

        send(
            chat_id,
            " SAVATCHAGA QO‘SHILDI!\n\n"
            " " + product["name"] + "\n"
            " " + str(qty) + " dona\n"
            " $" + format(summa, ".2f"),
            {
                "inline_keyboard": [
                    [
                        {
                            "text": " Yana mahsulot",
                            "callback_data": "categories"
                        }
                    ],
                    [
                        {
                            "text": " SAVATCHANI KO‘RISH",
                            "callback_data": "cart"
                        }
                    ]
                ]
            }
        )
        return

    # ========================================================
    # ZAKAZNI TASDIQLASH CALLBACK ORQALI BAJARILADI
    # ========================================================

    if chat_id in orders:
        send(chat_id, "Zakazni tasdiqlash uchun tugmani bosing.")
        return

    # ========================================================
    # BOSHQA XABAR
    # ========================================================

    send(
        chat_id,
        " Salom!\n\n"
        "Mahsulot tanlash uchun "
        " MAHSULOTLAR tugmasini bosing.",
        main_menu(chat_id)
    )


